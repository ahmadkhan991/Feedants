# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8081

# Database
MONGO_URI=mongodb://127.0.0.1:27017/feedants
# For production, use a replica-set / Atlas URI - transactions require a replica set:
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/feedants?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# File storage (submissions) - abstracted behind services/storageService.js
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Registration hold window (minutes) - how long a pending_payment reservation
# is allowed to hold a spot before being auto-released
PENDING_HOLD_MINUTES=10

# Hurry-up threshold (hours) shown as an urgency flag when close to a deadline
HURRY_UP_THRESHOLD_HOURS=24
